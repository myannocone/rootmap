default_platform(:ios)

platform :ios do
  desc "Push a new build to TestFlight with automatic build numbering"
  lane :beta do
    # 1. Authenticate with App Store Connect API
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true,
      in_house: false
    )

    # 2. Automatically sync build number using GitHub Actions run number or TestFlight increment
    build_num = ENV["GITHUB_RUN_NUMBER"] || (latest_testflight_build_number(api_key: api_key) + 1).to_s
    increment_build_number(
      build_number: build_num,
      xcodeproj: "App.xcodeproj"
    )

    # 3. Code signing & provisioning
    get_certificates
    get_provisioning_profile(
      app_identifier: "com.myannocone.rootmap"
    )

    # 4. Build and archive the iOS app
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.myannocone.rootmap" => ENV["sigh_com.myannocone.rootmap_appstore_profile-name"]
        }
      }
    )

    # 5. Distribute to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
