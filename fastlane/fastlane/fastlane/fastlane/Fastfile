default_platform(:ios)

platform :ios do
  desc "Push a new build to TestFlight with automatic build numbering"
  lane :beta do
    # 1. Authenticate with App Store Connect API
    key_content = ENV["APP_STORE_CONNECT_API_KEY"] || 
                  ENV["APP_STORE_CONNECT_KEY_CONTENT"] || 
                  ENV["APP_STORE_CONNECT_PRIVATE_KEY"] || 
                  ENV["APP_STORE_CONNECT_API_KEY_KEY"]

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"] || ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"] || ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: key_content,
      is_key_content_base64: true,
      in_house: false
    )

    # 2. Get GitHub Actions run number for build versioning
    build_num = ENV["GITHUB_RUN_NUMBER"] || "2"

    # 3. Code signing & provisioning
    get_certificates
    get_provisioning_profile(
      app_identifier: "com.myannocone.rootmap"
    )

    # 4. Build and archive passing the build number directly to Xcode
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_num}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.myannocone.rootmap" => ENV["sigh_com.myannocone.rootmap_appstore_profile-name"]
        }
      }
    )

    # 5. Distribute to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
