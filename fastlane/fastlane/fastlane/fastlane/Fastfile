default_platform(:ios)

platform :ios do
  desc "Push a new build to TestFlight with automatic build numbering"
  lane :beta do
    # 1. Automatically set build number using GitHub Actions run number
    build_num = ENV["GITHUB_RUN_NUMBER"] || "2"
    increment_build_number(
      build_number: build_num
    )

    # 2. Code signing & provisioning
    get_certificates
    get_provisioning_profile(
      app_identifier: "com.myannocone.rootmap"
    )

    # 3. Build and archive the iOS app
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.myannocone.rootmap" => ENV["sigh_com.myannocone.rootmap_appstore_profile-name"]
        }
      }
    )

    # 4. Distribute to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end
end
