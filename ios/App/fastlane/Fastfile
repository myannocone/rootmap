default_platform(:ios)

platform :ios do
  desc "Push a new build to TestFlight"
  lane :beta do
    raw_key = ENV["APP_STORE_CONNECT_API_KEY"].to_s.strip
    is_base64 = !raw_key.start_with?("-----BEGIN")

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip,
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip,
      key_content: raw_key,
      is_key_content_base64: is_base64,
      in_house: false
    )

    build_num = ENV["GITHUB_RUN_NUMBER"] || "2"


    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.myannocone.rootmap"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_num}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.myannocone.rootmap" => ENV["sigh_com.myannocone.rootmap_appstore_profile-name"]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
