default_platform(:ios)

platform :ios do
  desc "Push a new build to TestFlight"
  lane :beta do
    key_content = ENV["APP_STORE_CONNECT_API_KEY"].to_s
    UI.user_error!("Missing APP_STORE_CONNECT_KEY_ID") if ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip.empty?
    UI.user_error!("Missing APP_STORE_CONNECT_ISSUER_ID") if ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip.empty?
    UI.user_error!("Missing APP_STORE_CONNECT_API_KEY") if key_content.strip.empty?

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: key_content,
      is_key_content_base64: !key_content.include?("BEGIN PRIVATE KEY"),
      in_house: false
    )

    get_certificates
    get_provisioning_profile(
      app_identifier: "com.myannocone.rootmap"
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['GITHUB_RUN_NUMBER'] || '2'}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "com.myannocone.rootmap" => ENV["sigh_com.myannocone.rootmap_appstore_profile-name"]
        }
      }
    )

    upload_to_testflight(
      app_identifier: "com.myannocone.rootmap",
      skip_waiting_for_build_processing: true
    )
  end
end
